# Original research notebooks contain unreviewed image outputs/private paths.
# Preserve them locally. Publication drafts stay in ignored outputs/ until cleared.
/notebooks/*.ipynb

# Generated artifacts and private preservation inventories belong outside Git.
/outputs/*
!/outputs/.gitkeep
/checkpoints/
